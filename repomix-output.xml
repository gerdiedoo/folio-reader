import { MaterialCommunityIcons, MaterialIcons } from '@expo/vector-icons';
import React, { useEffect, useRef } from 'react';
import { Animated, Easing, StyleProp, TextStyle } from 'react-native';

/**
 * The web app used the Material Symbols webfont ("local_library", "menu_book", …).
 * On native we map the same names onto the Material icon sets bundled with
 * @expo/vector-icons so call sites keep their original icon names.
 */
type MIName = React.ComponentProps<typeof MaterialIcons>['name'];
type MCIName = React.ComponentProps<typeof MaterialCommunityIcons>['name'];

const MI: Record<string, MIName> = {
  local_library: 'local-library',
  menu_book: 'menu-book',
  tune: 'tune',
  arrow_back: 'arrow-back',
  bookmark: 'bookmark',
  bookmark_border: 'bookmark-border',
  bookmark_add: 'bookmark-add',
  search: 'search',
  close: 'close',
  volume_up: 'volume-up',
  style: 'style',
  touch_app: 'touch-app',
  account_circle: 'account-circle',
  help: 'help',
  info: 'info',
  local_fire_department: 'local-fire-department',
  travel_explore: 'travel-explore',
  done: 'done',
  check: 'check',
  check_small: 'check',
  check_circle: 'check-circle',
  cloud_upload: 'cloud-upload',
  palette: 'palette',
  upload_file: 'upload-file',
  upload: 'upload',
  file_upload: 'file-upload',
  sync: 'sync',
  image: 'image',
  title: 'title',
  sort: 'sort',
  expand_more: 'expand-more',
  unfold_more: 'unfold-more',
  add: 'add',
  mic: 'mic',
  edit_note: 'edit-note',
  translate: 'translate',
  ios_share: 'ios-share',
  delete: 'delete',
  delete_outline: 'delete-outline',
  history_edu: 'history-edu',
  post_add: 'post-add',
  open_in_new: 'open-in-new',
  hub: 'hub',
  output: 'output',
  database: 'storage',
  content_copy: 'content-copy',
  auto_stories: 'auto-stories',
  fullscreen: 'fullscreen',
  fullscreen_exit: 'fullscreen-exit',
  more_vert: 'more-vert',
  chevron_left: 'chevron-left',
  chevron_right: 'chevron-right',
  schedule: 'schedule',
  pause: 'pause',
  play_arrow: 'play-arrow',
  replay_10: 'replay-10',
  forward_10: 'forward-10',
  format_size: 'format-size',
  speed: 'speed',
  format_align_justify: 'format-align-justify',
  format_line_spacing: 'format-line-spacing',
  density_large: 'density-large',
  view_day: 'view-day',
  format_indent_increase: 'format-indent-increase',
  vertical_split: 'vertical-split',
};

const MCI: Record<string, MCIName> = {
  ink_pen: 'fountain-pen-tip',
  format_ink_highlighter: 'marker',
};

export type IconName = keyof typeof MI | keyof typeof MCI;

interface IconProps {
  name: IconName;
  size?: number;
  color?: string;
  /** Continuously rotate (used for the sync / upload spinners). */
  spin?: boolean;
  style?: StyleProp<TextStyle>;
}

export const Icon: React.FC<IconProps> = ({ name, size = 24, color = '#1c1c18', spin, style }) => {
  const rotation = useRef(new Animated.Value(0)).current;

  useEffect(() => {
    if (!spin) {
      rotation.setValue(0);
      return;
    }
    const loop = Animated.loop(
      Animated.timing(rotation, {
        toValue: 1,
        duration: 900,
        easing: Easing.linear,
        useNativeDriver: true,
      })
    );
    loop.start();
    return () => loop.stop();
  }, [spin, rotation]);

  const glyph = MCI[name] ? (
    <MaterialCommunityIcons name={MCI[name]} size={size} color={color} style={style} />
  ) : (
    <MaterialIcons name={MI[name] ?? 'help-outline'} size={size} color={color} style={style} />
  );

  if (!spin) return glyph;

  const rotate = rotation.interpolate({ inputRange: [0, 1], outputRange: ['0deg', '360deg'] });
  return <Animated.View style={{ transform: [{ rotate }] }}>{glyph}</Animated.View>;
};
</file>

<file path="src/components/ui/ModalShell.tsx">
import React from 'react';
import {
  KeyboardAvoidingView,
  Modal,
  Platform,
  Pressable,
  StyleProp,
  StyleSheet,
  View,
  ViewStyle,
} from 'react-native';
import { useSafeAreaInsets } from 'react-native-safe-area-context';
import { colors } from '../../theme';

interface ModalShellProps {
  onClose: () => void;
  children: React.ReactNode;
  /** Where the card sits on screen. */
  align?: 'center' | 'top' | 'bottom';
  maxWidth?: number;
  cardStyle?: StyleProp<ViewStyle>;
}

/**
 * Replacement for the web's `fixed inset-0` scrim + centered dialog pattern.
 * Used by every dialog and bottom sheet in the app.
 */
export const ModalShell: React.FC<ModalShellProps> = ({
  onClose,
  children,
  align = 'center',
  maxWidth = 448,
  cardStyle,
}) => {
  const insets = useSafeAreaInsets();
  const isBottom = align === 'bottom';

  return (
    <Modal
      visible
      transparent
      animationType={isBottom ? 'slide' : 'fade'}
      onRequestClose={onClose}
      statusBarTranslucent
    >
      <KeyboardAvoidingView
        style={styles.fill}
        behavior={Platform.OS === 'ios' ? 'padding' : undefined}
      >
        <View
          style={[
            styles.fill,
            {
              justifyContent: isBottom ? 'flex-end' : align === 'top' ? 'flex-start' : 'center',
              paddingTop: align === 'top' ? insets.top + 56 : insets.top + 16,
              paddingBottom: isBottom ? 0 : insets.bottom + 16,
              paddingHorizontal: isBottom ? 0 : 16,
            },
          ]}
        >
          <Pressable style={styles.scrim} onPress={onClose} />
          <View
            style={[
              styles.card,
              isBottom ? styles.sheet : styles.dialog,
              { maxWidth, paddingBottom: isBottom ? insets.bottom : 0 },
              cardStyle,
            ]}
          >
            {children}
          </View>
        </View>
      </KeyboardAvoidingView>
    </Modal>
  );
};

const styles = StyleSheet.create({
  fill: { flex: 1 },
  scrim: { position: 'absolute', top: 0, left: 0, right: 0, bottom: 0, backgroundColor: colors.scrim },
  card: {
    width: '100%',
    alignSelf: 'center',
    backgroundColor: colors.surface,
    overflow: 'hidden',
    borderWidth: StyleSheet.hairlineWidth,
    borderColor: colors.border,
    maxHeight: '88%',
  },
  dialog: {
    borderRadius: 16,
    elevation: 12,
    shadowColor: '#000',
    shadowOpacity: 0.25,
    shadowRadius: 24,
    shadowOffset: { width: 0, height: 12 },
  },
  sheet: {
    backgroundColor: colors.surfaceLow,
    borderTopLeftRadius: 24,
    borderTopRightRadius: 24,
  },
});
</file>

